# Include vendored manim-src (optimized manim bundle)
graft manim-src

# Include essential files
include LICENSE
include README_EN.md
include pyproject.toml

# Include docs for deployment to working directory
graft src/manim_web/docs

# Exclude development files
prune .github
prune tests
prune _render_tmp
prune media
prune src/manim_web/docs/templates/media
prune src/manim_web/docs/templates/__pycache__

# Exclude bytecode and caches
global-exclude *.py[cod] __pycache__